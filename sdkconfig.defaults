CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000

# Recovery protocol uses Wi-Fi; diagnostic console uses native USB.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# Recovery builds disable the USB console before taking GPIO19/20.

# the key and the pulses busy-wait on core 1
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000

CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=100

# XIAO ESP32-S3 Sense: 8 MB external flash, 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# Diagnostic build retains USB Serial/JTAG, recovery build releases its pads explicitly.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
